{
  "name": "@hmr-lukas/heft-tailwind-plugin",
  "version": "1.0.0",
  "description": "Tailwind CSS v4 task plugin for Heft and SharePoint Framework projects.",
  "type": "commonjs",
  "main": "./dist/TailwindPlugin.js",
  "types": "./dist/TailwindPlugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/TailwindPlugin.d.ts",
      "require": "./dist/TailwindPlugin.js",
      "default": "./dist/TailwindPlugin.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "heft-tailwind": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "heft-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "heft-plugin",
    "heft-tailwind-plugin",
    "postcss",
    "tailwind",
    "tailwindcss",
    "spfx",
    "sharepoint-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMR-Lukas/heft-tailwind-plugin.git"
  },
  "homepage": "https://github.com/HMR-Lukas/heft-tailwind-plugin#readme",
  "bugs": {
    "url": "https://github.com/HMR-Lukas/heft-tailwind-plugin/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "check": "npm run check:types && npm run check:package",
    "check:package": "publint --strict",
    "check:types": "tsc --noEmit",
    "clean": "tsdown --clean",
    "dev": "tsdown --watch",
    "pack:check": "npm pack --dry-run",
    "pretest": "npm run build",
    "release": "changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run build && npm run check && npm test && npm run pack:check",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "jsonc-parser": "^3.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@rushstack/heft": "1.1.2",
    "@types/node": "^22.18.0",
    "publint": "^0.3.15",
    "tsdown": "^0.15.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
